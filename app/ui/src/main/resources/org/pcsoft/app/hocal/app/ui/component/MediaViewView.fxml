<?import java.net.URL?>
<?import javafx.scene.image.ImageView?>
<fx:root type="javafx.scene.layout.StackPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.hocal.app.ui.component.MediaViewView"
         fx:id="pnlRoot" styleClass="media-view" minWidth="0.0" minHeight="0.0">
    <stylesheets>
        <URL value="@MediaViewView.css"/>
    </stylesheets>
    <ImageView fx:id="imgMedia" id="imgMedia" styleClass="media-image" preserveRatio="true" smooth="true"/>
    <ImageView fx:id="imgPlaceholder" id="imgPlaceholder" styleClass="media-placeholder" fitWidth="96.0"
               fitHeight="96.0" preserveRatio="true" smooth="true" visible="false"/>
</fx:root>
