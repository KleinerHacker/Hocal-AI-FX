<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import org.pcsoft.app.hocal.app.ui.component.FlowList?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.pcsoft.app.hocal.app.ui.window.MainWindowView"
            prefHeight="800.0" prefWidth="1280.0" fx:id="pnlRoot">

    <top>
        <MenuBar>
            <Menu text="%window.main.menu.file">
                <MenuItem text="%window.main.menu.file.exit" accelerator="Shortcut+Q" onAction="#actionExit"/>
            </Menu>
        </MenuBar>
    </top>

    <left>
        <FlowList fx:id="flowList" prefWidth="280.0"/>
    </left>

    <center>
        <Label fx:id="lblSelection" styleClass="selection-hint"/>
    </center>
</BorderPane>
